---
/* The floti.dev home page. Composition first, then the fleet; plugins, the
 * browser and persistence next; the install command last.
 * Every word outside the demos' drawings comes from copy.yaml. */
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import InstallBox from '../components/InstallBox.astro';
import Parallax from '../components/Parallax.astro';
import Feature from '../components/Feature.astro';
import HeroDemo from '../components/demos/HeroDemo.astro';
import ComposeDemo from '../components/demos/ComposeDemo.astro';
import FleetDemo from '../components/demos/FleetDemo.astro';
import MachinesDemo from '../components/demos/MachinesDemo.astro';
import PluginsDemo from '../components/demos/PluginsDemo.astro';
import BrowserDemo from '../components/demos/BrowserDemo.astro';
import PersistDemo from '../components/demos/PersistDemo.astro';
import { copy } from '../copy';

const github = 'https://github.com/floti-dev';
const { nav, hero, sections, footer } = copy;
---

<Base title={copy.page.title} description={copy.page.description}>
  <Parallax />

  <header class="nav">
    <div class="nav-in">
      <a class="brand" href="/" aria-label={nav.home}>
        <Logo kind="mark" class="brand-mark" />
        <Logo kind="word" class="brand-word" />
      </a>
      <nav class="nav-links" aria-label="Site">
        <a href="/install/">{nav.install}</a>
        <a class="wide" href={github}>{nav.github}</a>
      </nav>
      <div class="toggle" role="group" aria-label={nav.palette}>
        <button type="button" data-palette-set="gold" aria-pressed="true">{nav.gold}</button>
        <button type="button" data-palette-set="sky" aria-pressed="false">{nav.sky}</button>
      </div>
    </div>
  </header>

  <main>
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-text">
        <Logo kind="word" class="hero-word" label="floti" />
        <h1 id="hero-title">{hero.headline}</h1>
        <p class="lede">{hero.lede}</p>
        <InstallBox id="hero" />
      </div>
      <div class="hero-stage">
        <div class="hero-ship" aria-hidden="true">
          <div class="hero-ship-rock"><Logo kind="silhouette" /></div>
        </div>
        <HeroDemo />
      </div>
    </section>

    <Feature id="composition" text={sections.composition} lead><ComposeDemo /></Feature>
    <Feature id="fleet" text={sections.fleet} lead><FleetDemo /></Feature>
    <Feature id="machines" text={sections.machines} lead><MachinesDemo /></Feature>
    <Feature id="plugins" text={sections.plugins}><PluginsDemo /></Feature>
    <Feature id="browser" text={sections.browser}><BrowserDemo /></Feature>
    <Feature id="persistence" text={sections.persistence}><PersistDemo /></Feature>

    <section class="feature launch wrap" aria-labelledby="install">
      <div class="feature-text">
        <p class="eyebrow lead">{sections.install.label}</p>
        <h2 class="h2" id="install">{sections.install.headline}</h2>
        <p class="lede">{sections.install.lede}</p>
        <InstallBox id="launch" />
        <p class="launch-links">
          <a href="/install/">{sections.install.guide_link}</a>
          <a href={github}>{sections.install.github_link}</a>
        </p>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="foot-in">
      <Logo kind="mark" class="foot-mark" />
      <p>{footer.line}</p>
      <nav class="foot-links" aria-label="Footer">
        <a href="/install/">{footer.install}</a>
        <a href={github}>{footer.github}</a>
      </nav>
    </div>
  </footer>
</Base>
