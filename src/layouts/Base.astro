---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** The palette shown until the visitor picks one with the switch. */
  palette?: 'gold' | 'sky';
}

const { title, description, palette = 'gold' } = Astro.props;

// The site's own files and nothing else: no inline script or style, nothing
// from another origin.
const csp = [
  "default-src 'none'",
  "script-src 'self'",
  "style-src 'self'",
  "img-src 'self' data:",
  "font-src 'self'",
  "base-uri 'none'",
  "form-action 'none'",
].join('; ');
---

<!doctype html>
<html lang="en" data-palette={palette}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="no-referrer" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <!-- the demos' numbers (a test card, timers) are not phone numbers to iOS -->
    <meta name="format-detection" content="telephone=no" />
    <!-- the app icon in each palette; the palette script turns on the one that
         matches (the page's own palette without script) -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" data-palette-icon="gold" media={palette === 'gold' ? undefined : 'not all'} />
    <link rel="icon" href="/favicon-sky.svg" type="image/svg+xml" data-palette-icon="sky" media={palette === 'sky' ? undefined : 'not all'} />
    <script is:inline src="/palette.js"></script>
  </head>
  <body>
    <!-- each page brings its own script -->
    <slot />
  </body>
</html>
