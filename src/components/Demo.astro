---
/* A demo's frame. The stage is drawn at a fixed size (its st-<name> class in
 * global.css gives --w and --h) and scaled to
 * the column by the demo runtime. The drawing is the demo's final frame, so
 * it reads with no script and under reduced motion; the caption says in words
 * what the drawing shows. The button's three labels come from copy.yaml and
 * the runtime swaps them.
 *
 * An interactive demo puts its own buttons in the "controls" slot, beside
 * Replay, and hands its script any wording it shows through `text`. */
import { copy } from '../copy';

interface Props {
  name: string;
  caption: string;
  loop?: boolean;
  bare?: boolean;
  interactive?: boolean;
  /** Wording the demo's script shows, from copy.yaml. */
  text?: Record<string, string>;
}

const { name, caption, loop = false, bare = false, interactive = false, text } = Astro.props;
const labels = copy.demos.buttons;
---

<figure
  class:list={['demo', { bare }]}
  data-demo={name}
  data-loop={loop ? 'true' : undefined}
  data-interactive={interactive ? 'true' : undefined}
  data-text={text ? JSON.stringify(text) : undefined}
>
  <div class:list={['stage', `st-${name}`]}>
    <div class="stage-in" aria-hidden="true">
      <slot />
    </div>
  </div>
  <figcaption class="sr-only">{caption}</figcaption>
  <div class="demo-ctl">
    <div class="demo-own"><slot name="controls" /></div>
    <button
      class="replay"
      type="button"
      data-mode={loop ? 'pause' : 'replay'}
      data-label-replay={labels.replay}
      data-label-pause={labels.pause}
      data-label-play={labels.play}
    >
      <svg class="i-replay" viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 8a5.5 5.5 0 1 0 1.7-4" /><path d="M2.5 2v3.2h3.2" /></svg>
      <svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 2.8v10.4L13 8z" /></svg>
      <svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M5.5 3v10M10.5 3v10" /></svg>
      <span class="replay-label">{loop ? labels.pause : labels.replay}</span>
    </button>
  </div>
</figure>
