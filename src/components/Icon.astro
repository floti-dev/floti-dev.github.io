---
/* Line icons for the drawn Floti window, on a 20px grid with the app's thin
 * stroke. Stroke width and colour come from the CSS that places them. */
const shapes = {
  terminal: '<rect x="2.5" y="4" width="15" height="12" rx="2"/><path d="M6 8.5l2.2 1.8L6 12.1M10.5 12.2h3.5"/>',
  layers: '<path d="M10 3l7.5 4-7.5 4-7.5-4z"/><path d="M2.5 10.5l7.5 4 7.5-4"/><path d="M2.5 13.8l7.5 4 7.5-4"/>',
  history: '<circle cx="10" cy="10" r="7"/><path d="M10 6v4.3l2.8 1.7"/>',
  file: '<path d="M5 2.5h6.5L15.5 6.5v11H5z"/><path d="M11.5 2.5v4h4"/>',
  globe: '<circle cx="10" cy="10" r="7.2"/><path d="M2.8 10h14.4M10 2.8c2.3 2.4 2.3 12 0 14.4M10 2.8c-2.3 2.4-2.3 12 0 14.4"/>',
  gear: '<circle cx="10" cy="10" r="2.6"/><path d="M10 2.5v2.2M10 15.3v2.2M2.5 10h2.2M15.3 10h2.2M4.7 4.7l1.6 1.6M13.7 13.7l1.6 1.6M4.7 15.3l1.6-1.6M13.7 6.3l1.6-1.6"/>',
  tasks: '<rect x="3" y="3" width="14" height="14" rx="2"/><path d="M6 7.2l1.2 1.2 2.2-2.2M11.5 7.5H14M6 12.4l1.2 1.2 2.2-2.2M11.5 12.7H14"/>',
  plus: '<path d="M10 4v12M4 10h12"/>',
  refresh: '<path d="M16 10a6 6 0 1 1-1.8-4.3"/><path d="M16 3.5v3.2h-3.2"/>',
  cube: '<path d="M10 2.8l6.5 3.6v7.2L10 17.2l-6.5-3.6V6.4z"/><path d="M3.5 6.4L10 10l6.5-3.6M10 10v7.2"/>',
  folderplus: '<path d="M2.5 5.5h5l1.5 1.8h8.5v8.7h-15z"/><path d="M10 10v4M8 12h4"/>',
  folder: '<path d="M2.5 5h5l1.5 1.8h8.5V16h-15z"/>',
  repo: '<rect x="4" y="2.5" width="12" height="15" rx="1.5"/><path d="M7 2.5v15"/>',
  caret: '<path d="M7 8l3 3 3-3"/>',
  caretright: '<path d="M8 7l3 3-3 3"/>',
  split: '<rect x="3" y="4" width="14" height="12" rx="1.5"/><path d="M10 4v12"/>',
  max: '<path d="M4 8V4h4M16 8V4h-4M4 12v4h4M16 12v4h-4"/>',
  min: '<path d="M2 10h16"/>',
  square: '<rect x="3" y="3" width="14" height="14"/>',
  close: '<path d="M3 3l14 14M17 3L3 17"/>',
  lock: '<rect x="4.5" y="9" width="11" height="8" rx="1.5"/><path d="M7 9V6.5a3 3 0 0 1 6 0V9"/>',
  arrowleft: '<path d="M12 5l-5 5 5 5"/>',
  arrowright: '<path d="M8 5l5 5-5 5"/>',
  server: '<rect x="3" y="3.5" width="14" height="5.5" rx="1.2"/><rect x="3" y="11" width="14" height="5.5" rx="1.2"/><path d="M6 6.2h.01M6 13.8h.01"/>',
  laptop: '<rect x="4.5" y="4" width="11" height="8" rx="1"/><path d="M2.5 15.5h15"/>',
  desktop: '<rect x="2.5" y="3.5" width="15" height="10" rx="1.2"/><path d="M7.5 17h5M10 13.5V17"/>',
  check: '<path d="M4.5 10.5l3.5 3.5 7.5-8"/>',
} as const;

export type IconName = keyof typeof shapes;

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 20 20" aria-hidden="true" focusable="false" set:html={shapes[name]} />
