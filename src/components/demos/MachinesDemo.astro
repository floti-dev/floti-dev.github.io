---
/* One window, every machine. This PC is in the sidebar; a server and a
 * laptop join it one by one over SSH, each with its sessions and the time a
 * keystroke takes to come back. The tester helper from the fleet section
 * turns out to be running on the server. At rest: all three hosts, tester open. */
import Demo from '../Demo.astro';
import { copy } from '../../copy';
import FlotiWindow from '../FlotiWindow.astro';
import Icon from '../Icon.astro';
---

<Demo name="machines" caption={copy.demos.descriptions.machines}>
  <FlotiWindow badge>
    <Fragment slot="side">
      <div class="fw-side-head">
        <span class="t">Sessions</span>
        <span class="fw-icon-btn"><Icon name="plus" /></span>
        <span class="fw-icon-btn"><Icon name="refresh" /></span>
      </div>
      <div class="fw-filter">Filter projects and sessions</div>
      <div class="fw-tree">
        <div class="host">
          <div class="hrow"><span class="dot ring"></span><span class="hn">This PC</span><span class="lat mono">1 ms</span></div>
          <div class="fw-row"><Icon name="repo" class="ico" /><span class="name">harbor-api</span><span class="branch">main</span></div>
          <div class="fw-row session" data-k="row-fix"><span class="dot"></span><span class="name">fix upload retry</span><span class="word">8m</span></div>
          <div class="fw-row"><Icon name="repo" class="ico" /><span class="name">tidewater-web</span><span class="branch">feature/checkout</span></div>
          <div class="fw-row session"><span class="dot idle"></span><span class="name">checkout form</span><span class="word">idle</span></div>
        </div>
        <div class="host" data-k="host-build">
          <div class="fw-rule"></div>
          <div class="hrow">
            <span class="dot ring" data-k="build-dot"></span><span class="hn mono">build-box</span>
            <span class="lat swap"><span class="gone" data-k="build-connecting">connecting</span><span class="gone" data-k="build-loading">loading</span><span class="mono" data-k="build-ms">24 ms</span></span>
          </div>
          <div class="fw-row" data-k="build-row"><Icon name="repo" class="ico" /><span class="name">harbor-api</span><span class="branch">main</span></div>
          <div class="fw-row session sel need" data-k="row-tester"><span class="dot need"></span><span class="name">tester</span><span class="word need">needs you</span></div>
          <div class="fw-row session" data-k="build-row"><span class="dot"></span><span class="name">nightly build</span><span class="word">12m</span></div>
        </div>
        <div class="host" data-k="host-laptop">
          <div class="fw-rule"></div>
          <div class="hrow">
            <span class="dot ring" data-k="laptop-dot"></span><span class="hn mono">laptop</span>
            <span class="lat swap"><span class="gone" data-k="laptop-connecting">connecting</span><span class="gone" data-k="laptop-loading">loading</span><span class="mono" data-k="laptop-ms">41 ms</span></span>
          </div>
          <div class="fw-row" data-k="laptop-row"><Icon name="repo" class="ico" /><span class="name">recipes</span><span class="branch">main</span></div>
          <div class="fw-row session" data-k="laptop-row"><span class="dot"></span><span class="name">meal planner</span><span class="word">3m</span></div>
        </div>
        <div class="add" data-k="add"><Icon name="plus" class="ico" />Add a host</div>
      </div>
    </Fragment>

    <div class="fw-island fw-pane">
      <div class="fw-strip">
        <span class="fw-tab" data-k="tab-fix"><span class="dot"></span><span class="label">fix upload retry</span></span>
        <span class="fw-tab on" data-k="tab-tester"><span class="dot need"></span><span class="label">tester</span><span class="need-word">needs you</span></span>
        <span class="fw-strip-plus"><Icon name="plus" /></span>
      </div>
      <div class="fw-crumb swapc">
        <span class="crumb gone" data-k="crumb-fix">harbor-api <span class="mono">main</span><span class="sep">·</span>This PC</span>
        <span class="crumb" data-k="crumb-tester"><span class="mono">build-box</span><span class="sep">/</span>harbor-api <span class="mono">main</span><span class="sep">·</span>helper of fix upload retry</span>
      </div>
      <div class="fw-body">
        <div class="view gone" data-k="view-fix">
          <div class="fw-term"><span class="ln"><span class="t-y">›</span> Uploads fail on a 503 and never retry. Fix it.</span><span class="ln">  <span class="t-ok">Edit</span> src/upload/retry.ts  <span class="t-ok">+18</span> <span class="t-r">−4</span></span><span class="ln"><span class="t-dim">  $</span> floti agent start <span class="t-b">scout</span></span><span class="ln"><span class="t-dim">  $</span> floti agent start <span class="t-b">tester</span> --host build-box</span><span class="ln"><span class="t-dim">  $</span> floti agent start <span class="t-b">docs</span></span><span class="ln t-dim">  Waiting on scout, tester and docs.</span></div>
        </div>
        <div class="view" data-k="view-tester">
          <div class="fw-term"><span class="ln" data-k="tt"><span class="t-y">›</span> Run the upload tests until green.</span><span class="ln t-dim" data-k="tt">  npm test -- upload</span><span class="ln" data-k="tt">  <span class="t-ok">✓ 11 passed</span>  <span class="t-r">✗ 1 failed</span></span><span class="ln" data-k="tt">  retry.test.ts timed out after 5000 ms.</span><span class="ln" data-k="tt">  The retry now waits up to 7 s with backoff.</span><span class="ln t-y" data-k="tt">  ? Raise this test's timeout to 10 s?  (y/n)</span></div>
        </div>
      </div>
    </div>

    <Fragment slot="status">
      <span>Floti 3.1.0</span>
      <span class="bar"></span>
      <span class="grp"><span class="dot"></span>3 working</span>
      <span class="grp need" data-k="st-need"><span class="dot need"></span>1 needs you</span>
      <span class="bar"></span>
      <span>This PC</span>
      <span class="grp" data-k="st-build"><span class="mono">build-box</span> 24 ms</span>
      <span class="grp" data-k="st-laptop"><span class="mono">laptop</span> 41 ms</span>
    </Fragment>
  </FlotiWindow>
</Demo>

<style>
  .host {
    overflow: hidden;
  }
  .hrow {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 26px;
    padding: 0 12px;
    font-size: 12.5px;
    font-weight: 500;
  }
  .hn.mono {
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 400;
  }
  .lat {
    margin-left: auto;
    font-size: 11px;
    font-weight: 400;
    color: var(--fl-fg-subtle);
  }
  .lat.mono,
  .lat .mono {
    font-family: var(--mono);
  }
  .swap {
    display: inline-grid;
    justify-items: end;
  }
  .swap > * {
    grid-area: 1 / 1;
  }
  .add {
    display: flex;
    align-items: center;
    gap: 7px;
    height: 26px;
    margin-top: 6px;
    padding: 0 12px;
    font-size: 12.5px;
    color: var(--fl-fg-subtle);
  }
  .add :global(.ico) {
    width: 13px;
    height: 13px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }
  .swapc {
    display: grid;
  }
  .swapc > .crumb {
    grid-area: 1 / 1;
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .view {
    position: absolute;
    inset: 0;
  }
</style>
