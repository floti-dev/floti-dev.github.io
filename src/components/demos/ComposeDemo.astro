---
/* Composition. A profile's layers slide in and stack, the stack launches as a
 * session in a tab, then a second profile composes a different stack for the
 * same repository. No agent is named: the tab says "agent" and the layers
 * use plain words. At rest: both tabs open, the review profile's stack shown. */
import Demo from '../Demo.astro';
import Icon from '../Icon.astro';

const stacks = {
  backend: [
    ['Shared instructions', ['house-rules.md']],
    ['Project instructions', ['harbor-api/INSTRUCTIONS.md']],
    ['Skills', ['review', 'release-notes', 'db-migrate']],
    ['Tools', ['browser', 'agents', 'postgres']],
    ['Plugins', ['tasks']],
  ],
  review: [
    ['Shared instructions', ['house-rules.md']],
    ['Project instructions', ['harbor-api/INSTRUCTIONS.md']],
    ['Skills', ['security-review', 'style-guide']],
    ['Tools', ['browser']],
  ],
} as const;
---

<Demo name="compose" caption="Two profiles for the same repository. The backend profile stacks shared instructions, the project's instructions, three skills, three tools and a plugin into a session that opens in a tab; the review profile stacks a smaller set and opens a second tab.">
  <div class="cmp">
    <div class="col profiles">
      <div class="cap">Profiles <span class="proj mono">harbor-api</span></div>
      <div class="prof" data-k="prof-backend">
        <span class="pn">backend</span>
        <span class="pd">Server work: migrations, tests, the task board</span>
      </div>
      <div class="prof on" data-k="prof-review">
        <span class="pn">review</span>
        <span class="pd">Reads and comments on changes</span>
      </div>
      <p class="note"><Icon name="lock" class="lock" />The agent's own settings are not touched.</p>
    </div>

    <div class="col stackcol">
      <div class="cap">Composed at launch</div>
      <div class="stacks">
        {
          (['backend', 'review'] as const).map((name) => (
            <div class:list={['stack', { gone: name === 'backend' }]} data-k={`stack-${name}`}>
              {stacks[name].map(([label, items]) => (
                <div class="slab" data-k={`slab-${name}`}>
                  <span class="sl">{label}</span>
                  <span class="items">
                    {items.map((item) => (
                      <span class="item mono">{item}</span>
                    ))}
                  </span>
                </div>
              ))}
            </div>
          ))
        }
        <div class="pill gone" data-k="pill-backend"><span class="dot"></span>agent <span class="mono">harbor-api · backend</span></div>
        <div class="pill gone" data-k="pill-review"><span class="dot"></span>agent <span class="mono">harbor-api · review</span></div>
      </div>
    </div>

    <div class="col wincol">
      <div class="cap">Session</div>
      <div class="pane">
        <div class="strip">
          <span class="tab" data-k="tab-backend"><span class="dot"></span>agent<span class="tg">backend</span></span>
          <span class="tab on" data-k="tab-review"><span class="dot"></span>agent<span class="tg">review</span></span>
        </div>
        <div class="crumb">harbor-api <span class="mono">main</span></div>
        <div class="body">
          <div class="term empty gone" data-k="term-empty">No session yet.</div>
          <div class="term gone" data-k="term-backend"><span class="ln" data-k="tb">Session ready in <span class="t-b">harbor-api</span></span><span class="ln" data-k="tb"><span class="t-dim">instructions</span> 2 files</span><span class="ln" data-k="tb"><span class="t-dim">skills</span>       review, release-notes,</span><span class="ln" data-k="tb">             db-migrate</span><span class="ln" data-k="tb"><span class="t-dim">tools</span>        browser, agents, postgres</span><span class="ln" data-k="tb"><span class="t-dim">plugins</span>      tasks</span><span class="ln" data-k="tb"><span class="t-y">›</span> Add the upload_attempts column.</span></div>
          <div class="term" data-k="term-review"><span class="ln" data-k="tr">Session ready in <span class="t-b">harbor-api</span></span><span class="ln" data-k="tr"><span class="t-dim">instructions</span> 2 files</span><span class="ln" data-k="tr"><span class="t-dim">skills</span>       security-review,</span><span class="ln" data-k="tr">             style-guide</span><span class="ln" data-k="tr"><span class="t-dim">tools</span>        browser</span><span class="ln" data-k="tr"><span class="t-y">›</span> Review the open pull request.</span></div>
        </div>
      </div>
    </div>
  </div>
</Demo>

<style>
  .cmp {
    display: grid;
    grid-template-columns: 236px 340px 1fr;
    gap: 36px;
    height: 100%;
    padding: 6px 4px;
    font: 400 13px/1.5 var(--body);
    color: var(--fl-fg);
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }
  .cap {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 22px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--fl-fg-subtle);
  }
  .proj {
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    padding: 2px 8px;
    border: 1px solid var(--fl-border-strong);
    border-radius: 999px;
    color: var(--fl-fg-muted);
  }
  .mono {
    font-family: var(--mono);
  }
  .prof {
    position: relative;
    display: grid;
    gap: 2px;
    padding: 12px 14px;
    background: var(--fl-surface);
    border: 1px solid var(--fl-border);
    border-radius: 4px;
  }
  .prof .pn {
    font-size: 14px;
    font-weight: 500;
  }
  .prof .pd {
    font-size: 12px;
    color: var(--fl-fg-muted);
  }
  .prof.on {
    background: var(--fl-active);
    border-color: var(--fl-border-strong);
  }
  .prof.on::before {
    content: '';
    position: absolute;
    left: -1px;
    top: 10px;
    bottom: 10px;
    width: 2px;
    border-radius: 2px;
    background: var(--fl-accent);
  }
  .note {
    margin: auto 0 4px;
    display: flex;
    gap: 8px;
    align-items: flex-start;
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--fl-fg-muted);
  }
  .note :global(.lock) {
    flex: none;
    width: 15px;
    height: 15px;
    margin-top: 1px;
    fill: none;
    stroke: var(--fl-fg-muted);
    stroke-width: 1.5;
  }

  .stacks {
    position: relative;
    flex: 1;
  }
  .stack {
    position: absolute;
    inset: 0 0 auto;
    display: grid;
    gap: 8px;
  }
  .slab {
    display: grid;
    gap: 6px;
    padding: 10px 14px;
    background: var(--fl-surface);
    border: 1px solid var(--fl-border-strong);
    border-radius: 4px;
  }
  .sl {
    font-size: 13px;
    font-weight: 500;
  }
  .items {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .item {
    font-size: 11px;
    line-height: 1;
    padding: 4px 7px;
    border-radius: 3px;
    background: var(--fl-surface-raised);
    color: var(--fl-fg-muted);
  }
  .pill {
    position: absolute;
    left: 50%;
    bottom: 8px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    white-space: nowrap;
    background: var(--fl-surface-raised);
    border: 1px solid var(--fl-accent);
    border-radius: 999px;
    font-size: 13px;
  }
  .pill .mono {
    font-size: 11px;
    color: var(--fl-fg-muted);
  }

  .pane {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
    background: var(--fl-surface);
    border: 1px solid var(--fl-border);
    border-radius: 3px;
    overflow: hidden;
  }
  .strip {
    flex: none;
    height: 36px;
    display: flex;
    background: var(--fl-surface-sunken);
    border-bottom: 1px solid var(--fl-border);
  }
  .tab {
    position: relative;
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 0 12px;
    overflow: hidden;
    white-space: nowrap;
    font-size: 12.5px;
    color: var(--fl-fg-muted);
    border-right: 1px solid var(--fl-border);
  }
  .tab.on {
    background: var(--fl-surface);
    color: var(--fl-fg);
    margin-bottom: -1px;
  }
  .tab.on::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 2px;
    background: var(--fl-accent);
  }
  .tg {
    font-size: 10px;
    line-height: 1;
    padding: 3px 6px;
    border-radius: 999px;
    color: var(--fl-accent-text);
    background: var(--fl-accent-soft);
  }
  .crumb {
    flex: none;
    height: 28px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 12px;
    border-bottom: 1px solid var(--fl-border);
    font-size: 11.5px;
    color: var(--fl-fg-muted);
  }
  .crumb .mono {
    font-size: 11px;
    color: var(--fl-fg-subtle);
  }
  .body {
    position: relative;
    flex: 1;
    background: var(--term);
  }
  .term {
    position: absolute;
    inset: 0;
    padding: 10px 12px;
    font: 400 11.5px/1.65 var(--mono);
    color: var(--term-fg);
    white-space: pre;
  }
  .term .ln {
    display: block;
  }
  .term.empty {
    display: grid;
    place-items: center;
    font-family: var(--body);
    font-size: 12px;
    color: var(--term-dim);
  }
</style>
