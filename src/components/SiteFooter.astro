---
/* The line along the bottom of every page: the app icon, the line about the
 * name, and the licence. */
import Logo from './Logo.astro';
import { copy } from '../copy';
import { LICENSE } from '../links';

const { footer } = copy;
---

<footer class="foot">
  <div class="foot-in">
    <Logo kind="icon" class="foot-icon" />
    <p>{footer.line}</p>
    <a class="foot-license" href={LICENSE}>{footer.license}</a>
  </div>
</footer>
